{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copiteur",
  "mainBinaryName": "Copiteur",
  "version": "1.1.0",
  "identifier": "com.robin.copiteur",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Copiteur",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "externalBin": [
      "binaries/rclone"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "./macos/en.lproj/InfoPlist.strings",
        "Resources/fr.lproj/InfoPlist.strings": "./macos/fr.lproj/InfoPlist.strings"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNjE4M0QwOTg4OTk0MUMKUldRY2xJbVkwSU5odXQ0QjhUeE1PMnFmQVl0bkZLWkpyMnJhRG9Tc3ZDOTAwa3RjTVlvNWVpNm8K",
      "endpoints": [
        "https://github.com/Splainte/Copiteur/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
